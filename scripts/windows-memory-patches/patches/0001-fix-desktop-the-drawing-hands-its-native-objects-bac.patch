+        // before; retired, it closes after the frame that last drew it.
+        made?.retire()
+        made = cover
+        return cover
     }
 
     private fun keyFor(tuning: WashTuning) = "octo|${tuning.contrast}|${tuning.saturation}|${tuning.brightnessCap}"
