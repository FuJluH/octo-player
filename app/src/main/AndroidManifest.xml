<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Telling a family member their request was approved, declined or
         added, and a manager that requests wait. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scanning a family QR code on the join screen. Phones without a
         camera still install Octo and type the code instead. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Whether a stream goes over Wi-Fi or mobile data, or cannot go at all. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- A rough position for Live radio near you, asked for only when "Use my
         location" is tapped. It is rounded to about a kilometer on the phone. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The music already on the phone. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Playing music with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Keeping the phone awake while it plays, or while it drives a TV or
         speaker it is casting to. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Hearing TVs and speakers answer on the Wi-Fi while looking for them. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Setting a song as the ringtone, notification sound or alarm. Android
         grants it only through its own switch, which Octo opens when asked. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Installing Octo's own updates, downloaded from its releases and
         checked against its signing key. Android asks the listener once to
         allow it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Updates that go in by themselves when Octo is left, after the first
         one Octo installed (Android 12 and newer). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- The phone's own equalizer, opened from the Sound page when one exists. -->
    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>

    <application
        android:name=".OctoApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:theme="@style/Theme.Octo"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Play something on Octo", asked of the voice assistant. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Family links, from a QR code the camera reads or a link tapped:
                 an invite (octo://join?server=...&invite=...), a sign-in to fill
                 in (octo://signin?server=...&username=...), or one handed over
                 from another device (octo://handover?t=...&k=...&s=...&h=...,
                 which the family page also sends as an intent:// link). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="octo" android:host="join" />
                <data android:scheme="octo" android:host="signin" />
                <data android:scheme="octo" android:host="handover" />
            </intent-filter>
        </activity>

        <!-- "Share to Octo" for a list: a file TuneMyMusic saved, or text.
             It hands the list to the main screen in Octo's own task, which
             opens Import, and closes at once. -->
        <activity
            android:name=".system.ShareToImportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
            </intent-filter>
        </activity>

        <!-- "Open with Octo" for audio files. It hands the file to the main
             screen in Octo's own task and closes at once. -->
        <activity
            android:name=".system.OpenWithActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/x-flac" />
            </intent-filter>
            <!-- Some apps call every file "application/octet-stream"; then
                 the name's ending says it is music. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\..*\\.mp3" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\..*\\.flac" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\..*\\.m4a" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\..*\\.ogg" />
                <data android:pathPattern=".*\\.opus" />
                <data android:pathPattern=".*\\..*\\.opus" />
                <data android:pathPattern=".*\\.wav" />
                <data android:pathPattern=".*\\..*\\.wav" />
                <data android:pathPattern=".*\\.aac" />
                <data android:pathPattern=".*\\..*\\.aac" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.OctoPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Covers for a car's screen, readable only by apps granted each one. -->
        <provider
            android:name=".playback.ArtworkProvider"
            android:authorities="${applicationId}.art"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- How Octo uses Google Cast: the standard receiver, no framework
             notification. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="app.winters.octo.cast.CastSetup" />

        <!-- Lets Android Auto show Octo as a music app. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Home screen widgets: the song that is on, and four ways to start music. -->
        <receiver
            android:name=".widget.NowPlayingWidget"
            android:exported="false"
            android:label="@string/now_playing">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing" />
        </receiver>
        <receiver
            android:name=".widget.QuickPlayWidget"
            android:exported="false"
            android:label="@string/widget_quick_play_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_play" />
        </receiver>

        <!-- Hears how an update's install went. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Headphone buttons and "resume" in the media controls. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
